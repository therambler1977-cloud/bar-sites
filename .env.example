# Required in production: signs owner login sessions. Any long random string.
SESSION_SECRET=

# Database. Leave both blank to use the local demo data in .data/db.json.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Which bar to show when the domain doesn't match one (local dev, preview deploys).
DEFAULT_BAR_SLUG=rusty-anchor

# Text-to-update: Claude reads the owner's texts, Twilio sends and receives them.
ANTHROPIC_API_KEY=
TWILIO_AUTH_TOKEN=
# Set this if the public webhook URL differs from what the server sees (e.g. behind a proxy).
TWILIO_WEBHOOK_URL=

# Google Business Profile sync (OAuth app with the business.manage scope).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
